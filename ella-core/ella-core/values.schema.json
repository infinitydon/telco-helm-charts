{
  "type": "object",
  "properties": {
    "topology": {
      "enum": [
        "standalone",
        "ha"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "internet",
            "internet-ims-sms"
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "bridge",
            "macvlan"
          ]
        },
        "master": {
          "type": "string",
          "minLength": 1
        },
        "coreAddresses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
          }
        }
      }
    }
  }
}
