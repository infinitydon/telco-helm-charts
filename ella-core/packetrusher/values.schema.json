{
  "type": "object",
  "properties": {
    "simulator": {
      "enum": [
        "packetrusher"
      ]
    },
    "backend": {
      "enum": [
        "ebpf",
        "userspace"
      ]
    },
    "ueCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "subscriber": {
      "type": "object",
      "properties": {
        "imsi": {
          "type": "string",
          "pattern": "^[0-9]{15}$"
        },
        "mcc": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "mnc": {
          "type": "string",
          "pattern": "^[0-9]{2,3}$"
        }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "sst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "sd": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
